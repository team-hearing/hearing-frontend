# Hearing Frontend - environment variables
# develop의 .env.local / .env.production을 참고. 보통 둘 중 하나면 충분.

# 클라이언트+서버 양쪽에서 사용하는 BE API base URL.
# Next.js 빌드 시 클라이언트 번들에 노출되므로 BE URL이 공개되어도 무방한 경우에만 사용.
NEXT_PUBLIC_BASE_URL=http://localhost:8080/api

# (선택) 서버 사이드 한정 API base URL. 정의되면 클라이언트 코드에는 노출되지 않고
# 서버 컴포넌트/Route Handler에서만 우선 사용된다.
# API_BASE_URL=http://localhost:8080
